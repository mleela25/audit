rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read access for students collection (needed for login)
    match /students/{studentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Users collection - users can manage their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
    }
    
    // Exam results collection - authenticated users can read/write
    match /examResults/{resultId} {
      allow read, write: if request.auth != null;
    }
    
    // Attendance collection - authenticated users can read/write
    match /attendance/{attendanceId} {
      allow read, write: if request.auth != null;
    }
    
    // Daily progress collection - authenticated users can read/write
    match /dailyProgress/{progressId} {
      allow read, write: if request.auth != null;
    }
    
    // Work Pool collection - authenticated users can read/write
    match /workPool/{entryId} {
      allow read, write: if request.auth != null;
    }
    
    // Test Tracker collection - authenticated users can read/write
    match /testTracker/{entryId} {
      allow read, write: if request.auth != null;
    }
    
    // Paper Check collection - authenticated users can read/write
    match /paperCheck/{entryId} {
      allow read, write: if request.auth != null;
    }
    
    // Doubt Box collection - authenticated users can read/write
    match /doubtBox/{entryId} {
      allow read, write: if request.auth != null;
    }
    
    // Cambridge Paper collection - authenticated users can read/write
    match /cambridgePaper/{entryId} {
      allow read, write: if request.auth != null;
    }
    
    // Calendar entries collection - authenticated users can read/write
    match /calendarEntries/{entryId} {
      allow read, write: if request.auth != null;
    }
    
    // Chapter progress collection - authenticated users can read/write
    match /chapterProgress/{progressId} {
      allow read, write: if request.auth != null;
    }
  }
}